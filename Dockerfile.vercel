FROM node:22-slim AS web-build
WORKDIR /workspace
COPY package.json package-lock.json ./
COPY apps/web/package.json ./apps/web/package.json
RUN npm ci
COPY apps/web ./apps/web
COPY shared ./shared
RUN npm run build -w @wedding/web

FROM maven:3.9-eclipse-temurin-25 AS api-build
WORKDIR /workspace
COPY shared ./shared
COPY apps/api ./apps/api
COPY --from=web-build /workspace/apps/web/dist ./apps/api/src/main/resources/static
RUN mvn -q -f apps/api/pom.xml package

FROM eclipse-temurin:25-jre
WORKDIR /app
COPY --from=api-build /workspace/apps/api/target/wedding-api-1.0.0-SNAPSHOT.jar /app/api.jar
ENV PORT=8086 UPLOAD_DIR=/tmp/wedding-uploads MEDIA_MAX_BYTES=4194304 DB_SSL_MODE=REQUIRED DB_POOL_MAX=4 COOKIE_SECURE=true
EXPOSE 8086
ENTRYPOINT ["java","-jar","/app/api.jar"]
