{
  "name": "wedding-card",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node infra/scripts/dev.mjs",
    "dev:web": "npm run dev -w @wedding/web",
    "dev:api": "node infra/scripts/api.mjs",
    "db:up": "node infra/scripts/db.mjs up",
    "db:down": "node infra/scripts/db.mjs down",
    "build": "npm run build -w @wedding/web && mvn -q -f apps/api/pom.xml package",
    "typecheck": "npm run typecheck -w @wedding/web",
    "test": "node infra/scripts/test.mjs",
    "test:e2e": "node infra/scripts/test.mjs"
  },
  "devDependencies": {
    "mysql2": "^3.24.6",
    "playwright": "^1.60.0",
    "prettier": "^3.9.10"
  }
}
